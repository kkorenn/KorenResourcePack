<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>KorenResourcePack</AssemblyName>
    <AssemblyName Condition="'$(Legacy)'=='true'">KorenResourcePack_legacy</AssemblyName>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <BuildRoot>$(MSBuildProjectDirectory)/build</BuildRoot>
    <DistDir>$(MSBuildProjectDirectory)/dist</DistDir>
    <OutputPath>$(DistDir)/</OutputPath>
    <IntermediateOutputPath Condition="'$(Legacy)'=='true'">obj/legacy/$(Configuration)/$(TargetFramework)/</IntermediateOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>CS0436;CS1701;CS1702;NU1701</NoWarn>
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>

    <_Home Condition="'$(HOME)'!=''">$(HOME)</_Home>
    <_Home Condition="'$(_Home)'=='' And '$(USERPROFILE)'!=''">$(USERPROFILE)</_Home>

    <Game Condition="'$(Game)'=='' And '$(ADOFAI)'!=''">$(ADOFAI)</Game>
    <Game Condition="'$(Game)'=='' And Exists('$(_Home)/Library/Application Support/Steam/steamapps/common/A Dance of Fire and Ice')">$(_Home)/Library/Application Support/Steam/steamapps/common/A Dance of Fire and Ice</Game>
    <Game Condition="'$(Game)'=='' And Exists('$(_Home)/.steam/steam/steamapps/common/A Dance of Fire and Ice')">$(_Home)/.steam/steam/steamapps/common/A Dance of Fire and Ice</Game>
    <Game Condition="'$(Game)'=='' And Exists('$(_Home)/.local/share/Steam/steamapps/common/A Dance of Fire and Ice')">$(_Home)/.local/share/Steam/steamapps/common/A Dance of Fire and Ice</Game>
    <Game Condition="'$(Game)'=='' And Exists('C:\Program Files (x86)\Steam\steamapps\common\A Dance of Fire and Ice')">C:\Program Files (x86)\Steam\steamapps\common\A Dance of Fire and Ice</Game>
    <Game Condition="'$(Game)'=='' And Exists('C:\Program Files\Steam\steamapps\common\A Dance of Fire and Ice')">C:\Program Files\Steam\steamapps\common\A Dance of Fire and Ice</Game>

    <Managed Condition="'$(Managed)'=='' And Exists('$(Game)/ADanceOfFireAndIce.app/Contents/Resources/Data/Managed')">$(Game)/ADanceOfFireAndIce.app/Contents/Resources/Data/Managed</Managed>
    <Managed Condition="'$(Managed)'=='' And Exists('$(Game)/A Dance of Fire and Ice_Data/Managed')">$(Game)/A Dance of Fire and Ice_Data/Managed</Managed>

    <UMM Condition="'$(UMM)'=='' And Exists('$(Managed)/UnityModManager')">$(Managed)/UnityModManager</UMM>
    <UMM Condition="'$(UMM)'==''">$(Managed)</UMM>
    <UnityModManagerDll Condition="'$(UnityModManagerDll)'=='' And Exists('$(UMM)/UnityModManager.dll')">$(UMM)/UnityModManager.dll</UnityModManagerDll>
    <UnityModManagerDll Condition="'$(UnityModManagerDll)'=='' And Exists('$(Managed)/UnityModManager.dll')">$(Managed)/UnityModManager.dll</UnityModManagerDll>
    <UnityModManagerDll Condition="'$(UnityModManagerDll)'==''">$(UMM)/UnityModManager.dll</UnityModManagerDll>
    <HarmonyDll Condition="'$(HarmonyDll)'=='' And Exists('$(UMM)/0Harmony.dll')">$(UMM)/0Harmony.dll</HarmonyDll>
    <HarmonyDll Condition="'$(HarmonyDll)'=='' And Exists('$(Managed)/0Harmony.dll')">$(Managed)/0Harmony.dll</HarmonyDll>
    <HarmonyDll Condition="'$(HarmonyDll)'==''">$(UMM)/0Harmony.dll</HarmonyDll>

    <DefineConstants Condition="'$(Legacy)'=='true'">$(DefineConstants);LEGACY</DefineConstants>

    <UnityProjectDir>$(MSBuildProjectDirectory)/KorenResourcePack-Unity</UnityProjectDir>
    <BuiltBundlesDir>$(UnityProjectDir)/BuiltAssetBundles</BuiltBundlesDir>
    <BundleName>korenresourcepackbundle</BundleName>
    <BundlesOutDir>$(MSBuildProjectDirectory)/Bundles</BundlesOutDir>
    <UnityProjectVersionFile>$(UnityProjectDir)/ProjectSettings/ProjectVersion.txt</UnityProjectVersionFile>

    <_UnityVersionRaw Condition="Exists('$(UnityProjectVersionFile)')">$([System.IO.File]::ReadAllText('$(UnityProjectVersionFile)'))</_UnityVersionRaw>
    <UnityVersion Condition="'$(_UnityVersionRaw)'!=''">$([System.Text.RegularExpressions.Regex]::Match('$(_UnityVersionRaw)', 'm_EditorVersion:\s*(\S+)').Groups[1].Value)</UnityVersion>

    <UnityBin Condition="'$(UnityBin)'=='' And '$(UNITY_PATH)'!='' And Exists('$(UNITY_PATH)')">$(UNITY_PATH)</UnityBin>
    <UnityBin Condition="'$(UnityBin)'=='' And '$(UnityVersion)'!='' And Exists('/Applications/Unity/Hub/Editor/$(UnityVersion)/Unity.app/Contents/MacOS/Unity')">/Applications/Unity/Hub/Editor/$(UnityVersion)/Unity.app/Contents/MacOS/Unity</UnityBin>
    <UnityBin Condition="'$(UnityBin)'=='' And '$(UnityVersion)'!='' And Exists('$(_Home)/Unity/Hub/Editor/$(UnityVersion)/Editor/Unity')">$(_Home)/Unity/Hub/Editor/$(UnityVersion)/Editor/Unity</UnityBin>
    <UnityBin Condition="'$(UnityBin)'=='' And '$(UnityVersion)'!='' And Exists('C:\Program Files\Unity\Hub\Editor\$(UnityVersion)\Editor\Unity.exe')">C:\Program Files\Unity\Hub\Editor\$(UnityVersion)\Editor\Unity.exe</UnityBin>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/*.cs" Exclude="src/*_legacy.cs" />
    <Compile Include="src/*_legacy.cs" Condition="'$(Legacy)'=='true'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(Managed)/Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Rewired_Core"><HintPath>$(Managed)/Rewired_Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RDTools"><HintPath>$(Managed)/RDTools.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(Managed)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(Managed)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextCoreFontEngineModule"><HintPath>$(Managed)/UnityEngine.TextCoreFontEngineModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextCoreTextEngineModule"><HintPath>$(Managed)/UnityEngine.TextCoreTextEngineModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(Managed)/Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(Managed)/UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(Managed)/UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(Managed)/UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Managed)/UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(Managed)/UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(Managed)/UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(Managed)/UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(Managed)/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.IO.Compression" Condition="Exists('$(Managed)/System.IO.Compression.dll')"><HintPath>$(Managed)/System.IO.Compression.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.IO.Compression.FileSystem" Condition="Exists('$(Managed)/System.IO.Compression.FileSystem.dll')"><HintPath>$(Managed)/System.IO.Compression.FileSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SkyHook.Unity"><HintPath>$(Managed)/SkyHook.Unity.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityFileDialog" Condition="'$(Legacy)'!='true' And Exists('$(Managed)/UnityFileDialog.dll')"><HintPath>$(Managed)/UnityFileDialog.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="StandaloneFileBrowser" Condition="'$(Legacy)'=='true' And Exists('$(Managed)/StandaloneFileBrowser.dll')"><HintPath>$(Managed)/StandaloneFileBrowser.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityModManager"><HintPath>$(UnityModManagerDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(HarmonyDll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <PropertyGroup>
    <Dest Condition="'$(Dest)'==''">$(Game)/Mods/KorenResourcePack</Dest>
    <StageRoot>$(BuildRoot)/stage</StageRoot>
    <StageDir>$(StageRoot)/KorenResourcePack</StageDir>
    <ZipPath>$(DistDir)/KorenResourcePack.zip</ZipPath>
    <ZipPath Condition="'$(Legacy)'=='true'">$(DistDir)/KorenResourcePack_legacy.zip</ZipPath>
    <InfoSrc>$(MSBuildProjectDirectory)/Info.json</InfoSrc>
    <InfoSrc Condition="'$(Legacy)'=='true'">$(MSBuildProjectDirectory)/Info_legacy.json</InfoSrc>
    <BundleSrc>$(MSBuildProjectDirectory)/Bundles</BundleSrc>
    <AutoPng>$(MSBuildProjectDirectory)/KorenResourcePack-Unity/Assets/Keyviewer/Auto.png</AutoPng>
  </PropertyGroup>

  <ItemGroup>
    <_BundleSource Include="$(UnityProjectDir)/Assets/Font/**/*" Exclude="$(UnityProjectDir)/Assets/Font/**/*.meta" />
    <_BundleSource Include="$(UnityProjectDir)/Assets/Keyviewer/**/*" Exclude="$(UnityProjectDir)/Assets/Keyviewer/**/*.meta" />
    <_BundleSource Include="$(UnityProjectDir)/Assets/Editor/CreateAssetBundles.cs" />
  </ItemGroup>

  <Target Name="_BundleEnvCheck" BeforeTargets="BuildAssetBundles" Condition="'$(SkipBundle)'!='true'">
    <Message Importance="high" Text="[Bundle] SkipBundle=true -> skipping AssetBundle build." Condition="'$(SkipBundle)'=='true'" />
    <Warning Text="[Bundle] No Unity Editor found (ProjectVersion=$(UnityVersion)). Set UNITY_PATH or -p:UnityBin=/path. Falling back to existing Bundles/." Condition="'$(UnityBin)'==''" />
    <Warning Text="[Bundle] UnityLockfile present at $(UnityProjectDir)/Temp/UnityLockfile — Editor may be open. If batchmode fails, close Editor or pass -p:SkipBundle=true." Condition="'$(UnityBin)'!='' And Exists('$(UnityProjectDir)/Temp/UnityLockfile')" />
  </Target>

  <Target Name="_ForceBundleClean" BeforeTargets="BuildAssetBundles" Condition="'$(ForceBundle)'=='true'">
    <Delete Files="$(BundlesOutDir)/$(BundleName);$(BundlesOutDir)/Linux/$(BundleName);$(BundlesOutDir)/Mac/$(BundleName)" />
  </Target>

  <Target Name="BuildAssetBundles"
          BeforeTargets="BeforeBuild"
          Inputs="@(_BundleSource)"
          Outputs="$(BundlesOutDir)/Mac/$(BundleName);$(BundlesOutDir)/Linux/$(BundleName);$(BundlesOutDir)/$(BundleName)"
          Condition="'$(SkipBundle)'!='true' And '$(UnityBin)'!=''">
    <Message Importance="high" Text="[Bundle] Sources changed (or missing output). Running Unity batchmode: $(UnityBin)" />
    <Exec Command="&quot;$(UnityBin)&quot; -batchmode -nographics -quit -projectPath &quot;$(UnityProjectDir)&quot; -executeMethod CreateAssetBundle.BuildAllAssetBundles -logFile &quot;$(MSBuildProjectDirectory)/.unity-build.log&quot;"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_UnityExit" />
    </Exec>
    <Error Condition="'$(_UnityExit)'!='0'" Text="[Bundle] Unity batchmode failed (exit $(_UnityExit)). See .unity-build.log" />

    <MakeDir Directories="$(BundlesOutDir);$(BundlesOutDir)/Linux;$(BundlesOutDir)/Mac" />
    <Copy SourceFiles="$(BuiltBundlesDir)/$(BundleName)"       DestinationFiles="$(BundlesOutDir)/$(BundleName)"       Condition="Exists('$(BuiltBundlesDir)/$(BundleName)')" />
    <Copy SourceFiles="$(BuiltBundlesDir)/Linux/$(BundleName)" DestinationFiles="$(BundlesOutDir)/Linux/$(BundleName)" Condition="Exists('$(BuiltBundlesDir)/Linux/$(BundleName)')" />
    <Copy SourceFiles="$(BuiltBundlesDir)/Mac/$(BundleName)"   DestinationFiles="$(BundlesOutDir)/Mac/$(BundleName)"   Condition="Exists('$(BuiltBundlesDir)/Mac/$(BundleName)')" />
    <Message Importance="high" Text="[Bundle] OK." />
  </Target>

  <Target Name="ValidatePaths" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(Game)')" Text="Could not locate ADOFAI install. Set env ADOFAI=/path/to/game or pass -p:Game=/path. Tried: ~/Library/Application Support/Steam/steamapps/common/A Dance of Fire and Ice, ~/.steam/..., C:\Program Files (x86)\Steam\..." />
    <Error Condition="!Exists('$(Managed)')" Text="Could not locate Managed/ under '$(Game)'. Override with -p:Managed=/path/to/Managed." />
    <Error Condition="!Exists('$(UnityModManagerDll)')" Text="UnityModManager.dll not found. Looked at '$(UnityModManagerDll)'. Install UMM into the game first, or pass -p:UMM=/path/to/UnityModManager or -p:UnityModManagerDll=/path/to/UnityModManager.dll." />
    <Error Condition="!Exists('$(HarmonyDll)')" Text="0Harmony.dll not found. Looked at '$(HarmonyDll)'. Install UMM into the game first, or pass -p:UMM=/path/to/UnityModManager or -p:HarmonyDll=/path/to/0Harmony.dll." />
    <Message Importance="high" Text="Game: $(Game)" />
    <Message Importance="high" Text="Managed: $(Managed)" />
    <Message Importance="high" Text="UnityModManager: $(UnityModManagerDll)" />
  </Target>

  <Target Name="Package" AfterTargets="Build">
    <ItemGroup>
      <_Fonts Include="Fonts/**/*.ttf;Fonts/**/*.ttc;$(MSBuildProjectDirectory)/KorenResourcePack-Unity/Assets/Font/*.ttf;$(MSBuildProjectDirectory)/KorenResourcePack-Unity/Assets/Font/*.ttc" />
      <_Bundles Include="$(BundleSrc)/**/*" Exclude="$(BundleSrc)/**/.DS_Store" />
    </ItemGroup>

    <RemoveDir Directories="$(StageRoot)" />
    <MakeDir Directories="$(DistDir);$(StageDir);$(StageDir)/Fonts;$(StageDir)/Bundles" />

    <Copy SourceFiles="$(InfoSrc)" DestinationFiles="$(StageDir)/Info.json" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(StageDir)" />
    <Copy SourceFiles="@(_Fonts)" DestinationFolder="$(StageDir)/Fonts" />
    <Copy SourceFiles="@(_Bundles)" DestinationFiles="@(_Bundles->'$(StageDir)/Bundles/%(RecursiveDir)%(Filename)%(Extension)')" Condition="Exists('$(BundleSrc)')" />
    <Copy SourceFiles="$(AutoPng)" DestinationFolder="$(StageDir)/Bundles" Condition="Exists('$(AutoPng)')" />

    <Delete Files="$(ZipPath)" />
    <ZipDirectory SourceDirectory="$(StageRoot)" DestinationFile="$(ZipPath)" />
    <Message Importance="high" Text="Zip: $(ZipPath)" />

  </Target>

  <Target Name="Install" AfterTargets="Package" Condition="'$(Install)'=='true' Or '$(Deploy)'=='true'">
    <ItemGroup>
      <_Fonts Include="Fonts/**/*.ttf;Fonts/**/*.ttc;$(MSBuildProjectDirectory)/KorenResourcePack-Unity/Assets/Font/*.ttf;$(MSBuildProjectDirectory)/KorenResourcePack-Unity/Assets/Font/*.ttc" />
      <_Bundles Include="$(BundleSrc)/**/*" Exclude="$(BundleSrc)/**/.DS_Store" />
    </ItemGroup>
    <Error Condition="!Exists('$(Game)')" Text="Install requested but Game path '$(Game)' not found." />
    <MakeDir Directories="$(Dest);$(Dest)/Fonts;$(Dest)/Bundles" />
    <Copy SourceFiles="$(InfoSrc)" DestinationFiles="$(Dest)/Info.json" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(Dest)" />
    <Copy SourceFiles="@(_Fonts)" DestinationFolder="$(Dest)/Fonts" />
    <Copy SourceFiles="@(_Bundles)" DestinationFiles="@(_Bundles->'$(Dest)/Bundles/%(RecursiveDir)%(Filename)%(Extension)')" Condition="Exists('$(BundleSrc)')" />
    <Copy SourceFiles="$(AutoPng)" DestinationFolder="$(Dest)/Bundles" Condition="Exists('$(AutoPng)')" />
    <Message Importance="high" Text="Installed to: $(Dest)" />
  </Target>

</Project>
