# ============================================================
# KorenResourcePack — comprehensive .gitignore
# Unity Mod Manager mod for A Dance of Fire and Ice
# Mac dev environment / C# + Unity 2022 + dotnet build
# ============================================================

# ------------------------------------------------------------
# macOS
# ------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ------------------------------------------------------------
# General scratch / editor temp
# ------------------------------------------------------------
*.tmp
*.bak
*.swp
*~

# ------------------------------------------------------------
# Build logs produced by build.sh
# ------------------------------------------------------------
*.log
.unity-build.log

# ------------------------------------------------------------
# dotnet / MSBuild build outputs
# build/obj/   — intermediate MSBuild artifacts (NuGet restore cache,
#                *.cache, *.AssemblyReference.cache, Release/ intermediates)
# build/bin/   — compiler outputs; Package copies from here into build/stage/
# build/stage/ — temporary packaging directory
# dist/ keeps the release zip files consumed by release.yml. Loose binaries are
# ignored so generated DLL/PDB/deps files do not sit beside release packages.
# ------------------------------------------------------------
/build/obj/
/build/bin/
/build/stage/
/bin/
/dist/*.deps.json
/dist/*.dll
/dist/*.pdb
/KorenResourcePack*.deps.json
/KorenResourcePack*.dll
/KorenResourcePack*.pdb
/KorenResourcePack*.zip

# ------------------------------------------------------------
# Unity subproject
#
# Keep Assets/, Packages/, ProjectSettings/, and BuiltAssetBundles/ tracked;
# ignore per-machine Unity caches and generated editor state.
# ------------------------------------------------------------
unity/Library/
unity/Temp/
unity/Logs/
unity/obj/
unity/Build/
unity/UserSettings/
unity/ExportedObj/
unity/Builds/

# ------------------------------------------------------------
# Python tooling scripts
# bot/fuckpython/ is an old local venv path — always ignored if present
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
bot/fuckpython/

# ------------------------------------------------------------
# IDE and editor metadata
# ------------------------------------------------------------
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.pidb
*.booproj

# Rider
.idea/

# Visual Studio Code (keep settings.json if intentional,
# but ignore workspace-local state)
.vscode/launch.json
.vscode/.ropeproject

# ------------------------------------------------------------
# NuGet / package manager
# (packages/ not present but standard; *.nupkg just in case)
# ------------------------------------------------------------
*.nupkg
packages/
!unity/Packages/
!unity/Packages/**
nuget.config.local

# ------------------------------------------------------------
# Misc dotnet / Roslyn
# ------------------------------------------------------------
*.pidb
*.pdb.bak

# ------------------------------------------------------------
# weppy-project-sync/ — currently empty, nothing to ignore
# (add entries here if it grows)
# ------------------------------------------------------------
